# PostgreSQL Configuration (Required)
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/postgres

# LLM API Configuration (At least one required)
OPENAI_API_KEY=sk-xxxx
GEMINI_API_KEY=AIza-xxxx

# Email Notifications (Optional - for SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# MS Teams Notifications (Optional)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxx
