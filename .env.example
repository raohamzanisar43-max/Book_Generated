# ---------------------------------------------------------------- Database
# Use a dedicated database for this app.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/book_generator

# ---------------------------------------------------------------- LLM
# auto   -> OpenAI if OPENAI_API_KEY is set, else Gemini (falls back to the other on error)
# openai | gemini -> force one provider
# mock   -> offline generator for demos/tests (no API key needed)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------- Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Recipient; defaults to SMTP_USER
NOTIFY_EMAIL_TO=
TEAMS_WEBHOOK_URL=

# ---------------------------------------------------------------- App
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins
CORS_ORIGINS=*
